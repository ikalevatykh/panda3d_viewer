from typing import Sequence, Optional
from numpy.typing import ArrayLike
from panda3d.core import Geom


def make_axes() -> Geom: ...
def make_grid(num_ticks: int = ..., step: float = ...) -> Geom: ...
def make_capsule(radius: float, length: float, num_segments: int = ..., num_rings: int = ...) -> Geom: ...
def make_cylinder(num_segments: int = ..., closed: bool = ...) -> Geom: ...
def make_box() -> Geom: ...
def make_plane(size: Sequence[float] = ...) -> Geom: ...
def make_sphere(num_segments: int = ..., num_rings: int = ...) -> Geom: ...
def make_points(vertices: ArrayLike, colors: Optional[ArrayLike] = ..., texture_coords: Optional[ArrayLike] = ..., geom: Optional[Geom] = ...) -> Geom: ...

__all__ = ("make_axes", "make_grid", "make_cylinder", "make_box", "make_plane", "make_sphere", "make_points")

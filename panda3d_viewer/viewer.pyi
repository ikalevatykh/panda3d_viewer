from typing import Mapping, Sequence, Literal, Union, Optional, Tuple, Type
import numpy as np
from numpy.typing import ArrayLike, NDArray
from .viewer_app import ViewerApp
from .viewer_config import ViewerConfig
from .viewer_errors import ViewerClosedError
from .viewer_proxy import ViewerAppProxy


_Vec2 = Sequence[float]
_Vec3 = Sequence[float]
_Vec4 = Sequence[float]
_Frame = Union[NDArray[np.float32], NDArray[np.float64], Tuple[_Vec3, _Vec4]]
_Material = Union[_Vec4, Tuple[_Vec4, str]]


class Viewer:
    _window_type: Literal["onscreen", "offscreen"]
    _app: Union[ViewerApp, ViewerAppProxy]
    def __init__(self, window_title: Optional[str] = ..., window_type: Literal["onscreen", "offscreen"] = ..., config: Optional[ViewerConfig] = ..., **kwargs: object) -> None: ...
    def join(self) -> None: ...
    def stop(self) -> None: ...
    def destroy(self) -> None: ...
    def append_group(self, root_path: str, remove_if_exists: bool = ..., scale: float = ...) -> None: ...
    def remove_group(self, root_path: str) -> None: ...
    def show_group(self, root_path: str, show: bool) -> None: ...
    def move_nodes(self, root_path: str, name_pose_dict: Mapping[str, _Frame]) -> None: ...
    def append_mesh(self, root_path: str, name: str, mesh_path: str, scale: Optional[_Vec3] = ..., frame: Optional[_Frame] = ..., no_cache: Optional[bool] = ...) -> None: ...
    def append_capsule(self, root_path: str, name: str, radius: float, length: float, frame: Optional[_Frame] = ...) -> None: ...
    def append_cylinder(self, root_path: str, name: str, radius: float, length: float, frame: Optional[_Frame] = ...) -> None: ...
    def append_box(self, root_path: str, name: str, size: _Vec3, frame: Optional[_Frame] = ...) -> None: ...
    def append_plane(self, root_path: str, name: str, size: _Vec2, frame: Optional[_Frame] = ...) -> None: ...
    def append_sphere(self, root_path: str, name: str, radius: float, frame: Optional[_Frame] = ...) -> None: ...
    def append_cloud(self, root_path: str, name: str, thickness: int = ..., frame: Optional[_Frame] = ...) -> None: ...
    def set_cloud_data(self, root_path: str, name: str, vertices: ArrayLike, colors: Optional[ArrayLike] = ..., texture_coords: Optional[ArrayLike] = ..., texture_image: Optional[NDArray[np.uint8]] = ...) -> None: ...
    def set_material(self, root_path: str, name: str, color_rgba: _Vec4, texture_path: str = ...) -> None: ...
    def set_materials(self, root_path: str, name_material_dict: Mapping[str, _Material]) -> None: ...
    def reset_camera(self, pos: _Vec3, look_at: _Vec3) -> None: ...
    def enable_lights(self, enable: bool) -> None: ...
    def enable_light(self, index: int, enable: bool) -> None: ...
    def enable_shadow(self, enable: bool) -> None: ...
    def enable_hdr(self, enable: bool) -> None: ...
    def enable_fog(self, enable: bool) -> None: ...
    def show_axes(self, show: bool) -> None: ...
    def show_grid(self, show: bool) -> None: ...
    def show_floor(self, show: bool) -> None: ...
    def set_background_color(self, color_rgb: _Vec3) -> None: ...
    def save_screenshot(self, filename: Optional[str] = ...) -> bool: ...
    def get_screenshot(self, requested_format: str = ...) -> Optional[NDArray[np.uint8]]: ...
    def __enter__(self) -> "Viewer": ...
    def __exit__(self, exctype: Optional[Type[BaseException]], excinst: Optional[BaseException], exctb: object) -> bool: ...

__all__ = ("Viewer",)
